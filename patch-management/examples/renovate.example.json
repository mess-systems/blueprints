{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Non-security patch and minor updates. Automerge stays off until that policy is decided.",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": false
    },
    {
      "description": "Major and breaking updates stay in a planned pull request.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
